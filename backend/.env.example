# Environment Configuration
APP_NAME="School Result Management System"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=school-super-secret-jwt-key-for-local-offline-development-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For Local/Offline zero-friction: sqlite:///./school.db
# For PostgreSQL Cloud/Server: postgresql+psycopg://postgres:postgres@localhost:5432/school_db
DATABASE_URL=sqlite:///./school.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]
